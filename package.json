{
  "name": "local-storage-browser",
  "version": "1.1.0",
  "description": "A comprehensive, lightweight JavaScript library for managing browser storage: LocalStorage, SessionStorage, Cookies, IndexedDB, and WebExtension Storage.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
